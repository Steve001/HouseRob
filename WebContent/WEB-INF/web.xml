<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://java.sun.com/xml/ns/javaee" xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd" id="WebApp_ID" version="2.5">
  <display-name>HouseRob</display-name>
  <welcome-file-list>
    <welcome-file>login.jsp</welcome-file>
  </welcome-file-list>
  <filter>
    <filter-name>loginFilter</filter-name>
    <filter-class>com.hr.filter.LoginFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>loginFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  
  <servlet>
    <servlet-name>loginServlet</servlet-name>
    <servlet-class>com.hr.web.customerLoginServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>loginServlet</servlet-name>
    <url-pattern>/login</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>houseSelectServlet</servlet-name>
    <servlet-class>com.hr.web.houseSelectServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>houseSelectServlet</servlet-name>
    <url-pattern>/houseSelect</url-pattern>
  </servlet-mapping>
  
  
  <servlet>
    <servlet-name>houseSelect_home1Servlet</servlet-name>
    <servlet-class>com.hr.web.houseSelectServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>houseSelectServlet</servlet-name>
    <url-pattern>/houseSelect_home1</url-pattern>
  </servlet-mapping>
  
   <servlet>
    <servlet-name>houseSelect_floor1ListServlet</servlet-name>
    <servlet-class>com.hr.web.houseSelectServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>houseSelectServlet</servlet-name>
    <url-pattern>/floorList1</url-pattern>
  </servlet-mapping>
  
  <servlet>
    <servlet-name>houseSelect_floor2ListServlet</servlet-name>
    <servlet-class>com.hr.web.houseSelectServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>houseSelectServlet</servlet-name>
    <url-pattern>/floorList2</url-pattern>
  </servlet-mapping>
  

</web-app>